APP_NAME=Flow Vul Hunt API
APP_ENV=development
DATABASE_URL=sqlite:///./data/flow_vul_hunt.db
MAX_UPLOAD_BYTES=52428800
CSV_STORAGE_DIR=./data/csv_uploads
MAX_PAYLOAD_CHARS=100000

# DeepSeek official OpenAI-compatible API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Alibaba Cloud Model Studio / Bailian, China public endpoint.
# If the console gives you a workspace-specific regional URL, replace this value.
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen3.7-plus

# Zhipu BigModel official OpenAI-compatible API
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.2

# Provider order per agent. The next configured provider is used after a failure.
LLM_ROUTE_PAYLOAD_ANALYST=deepseek,bailian,zhipu
LLM_ROUTE_EVIDENCE_VERIFIER=zhipu,bailian,deepseek
LLM_ROUTE_HUNT_INTERPRETER=bailian,zhipu,deepseek
LLM_ROUTE_REPORT_GENERATOR=bailian,deepseek,zhipu

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=24000

AGENT_ENABLED=true
AGENT_COLLABORATION_ENABLED=true
AGENT_REQUIRE_CONFIRMATION=true

